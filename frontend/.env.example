# Opcional: copia como frontend/.env. Solo van valores PÚBLICOS (todo VITE_* llega al navegador).

# URL pública de Supabase para las imágenes. Si falta, vite.config.ts usa SUPABASE_URL de backend/.env.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Backend al que Vite redirige /api en desarrollo (por defecto http://127.0.0.1:4000)
BACKEND_PROXY_URL=http://127.0.0.1:4000
