{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:seed": "npx prisma db seed",
    "prisma:migrate": "npx prisma migrate dev",
    "seed": "npm run prisma:generate && npm run prisma:seed",
    "test": "npm run test:unit",
    "test:unit": "tsx --test test/*.test.ts",
    "test:integration": "cross-env RUN_INTEGRATION_TESTS=true tsx --test test/integration/*.integration.test.ts",
    "test:e2e:security": "playwright test test/e2e/sec-003.e2e.spec.ts",
    "test:e2e:sec006": "playwright test test/e2e/sec-006-auth-session.spec.ts",
    "test:e2e": "playwright test test/e2e/*.e2e.spec.ts",
    "test:critical": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^6.12.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.112.3",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pino": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.35.4",
    "tiny-csrf": "^1.1.6",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
