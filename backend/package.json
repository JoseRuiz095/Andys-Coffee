{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node dev.js",
    "start": "cross-env NODE_ENV=production tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "prisma:generate": "npx prisma generate",
    "prisma:seed": "npx prisma db seed",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prisma:migrate:deploy:prod": "cross-env NODE_ENV=production prisma migrate deploy",
    "seed": "npm run prisma:generate && npm run prisma:seed",
    "catalog:export": "tsx scripts/export-catalog.ts",
    "catalog:export:prod": "cross-env NODE_ENV=production tsx scripts/export-catalog.ts",
    "storage:copy-to-dev": "tsx scripts/copy-storage-to-dev.ts",
    "db:replicate-prod-to-dev": "tsx scripts/replicate-prod-to-dev.ts",
    "db:reset-operations": "tsx scripts/reset-operational-data.ts",
    "db:reset-operations:prod": "cross-env NODE_ENV=production tsx scripts/reset-operational-data.ts",
    "test": "npm run test:unit",
    "test:unit": "tsx --test test/*.test.ts",
    "test:db:up": "sh test/db/generate-certs.sh && docker compose -f test/db/docker-compose.yml up -d --wait",
    "test:db:prepare": "tsx test/db/prepare.ts",
    "test:db:down": "docker compose -f test/db/docker-compose.yml down -v",
    "test:integration": "tsx --import ./test/setup/test-env.ts --test --test-concurrency=1 test/integration/*.integration.test.ts",
    "test:e2e:security": "playwright test test/e2e/sec-003.e2e.spec.ts",
    "test:e2e:sec006": "playwright test test/e2e/sec-006-auth-session.spec.ts",
    "test:e2e": "playwright test test/e2e/ --workers=1",
    "test:critical": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^6.12.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.112.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "pino": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.35.4",
    "tiny-csrf": "^1.1.6",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "kill-port": "^2.0.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
