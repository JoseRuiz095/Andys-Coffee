# Plantilla de backend/.env.development y backend/.env.production (una copia por entorno).
# El backend elige el archivo según NODE_ENV del proceso (desarrollo por defecto; ver src/config/env.ts).
# Nunca subas los archivos .env.* al repositorio.
# Desarrollo y producción deben usar bases de datos y secretos DISTINTOS
# (si .env.development apunta a la BD de .env.production, el backend lo avisa y bloquea
# prisma migrate dev/reset y db push).

# --- Servidor ---
PORT=4000
# Orígenes permitidos por CORS, separados por comas (obligatorio en producción)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# Zona horaria del negocio: define el día de negocio, reportes y el cierre automático de caja
CASH_TIMEZONE=America/Mexico_City
# Número de proxies inversos delante de la API. Déjalo vacío si la API se accede directo (local).
# En producción (Vercel rewrite → Render → contenedor) NO se fija de antemano: se determina y
# valida durante el despliegue (ver docs/deployment.md, "TRUST_PROXY").
TRUST_PROXY=

# --- Seguridad ---
# Al menos 32 caracteres y 16 distintos (p. ej. `openssl rand -base64 48`)
JWT_SECRET=
# Exactamente 32 caracteres
CSRF_SECRET=

# --- Base de datos (Supabase Postgres) ---
# Conexión de la app (pooler). Debe incluir sslmode=require o verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Conexión directa para Prisma Migrate
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Certificado CA de Supabase (Project Settings → Database → SSL). Usa UNA de las dos:
#  - DATABASE_SSL_CA_PATH: ruta al archivo (local: certs/…; Render: Secret File, p. ej. /etc/secrets/supabase-ca.crt)
#  - DATABASE_SSL_CA: el contenido PEM del certificado (útil en contenedores; tiene prioridad sobre la ruta)
# Un certificado por entorno: certs/dev/… en .env.development, certs/prod/… en .env.production
DATABASE_SSL_CA_PATH=certs/dev/prod-ca-2021.crt
# DATABASE_SSL_CA=

# --- Imágenes de productos (Supabase Storage) ---
# La API recibe la foto, la convierte a WebP y la guarda en el bucket (lectura pública).
# Sin estas dos variables el menú funciona, pero no se pueden subir ni quitar imágenes (503).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Solo backend: Storage rechaza escrituras con la anon key. NUNCA en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Opcionales (valores por defecto):
# PRODUCT_IMAGE_BUCKET=Img
# PRODUCT_IMAGE_MAX_UPLOAD_MB=10
# PRODUCT_IMAGE_MAX_DIMENSION=1200
# PRODUCT_IMAGE_WEBP_QUALITY=80

# --- Seed ---
# Contraseña inicial de admin@andyscoffee.local (obligatoria con NODE_ENV=production)
ADMIN_SEED_PASSWORD=

# --- Jobs (opcional) ---
# ENABLE_CASH_AUTO_CLOSE=false
# ENABLE_CASH_RECONCILIATION=false
