generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String              @id @default(uuid())
  name                 String
  email                String              @unique
  passwordHash         String
  isActive             Boolean             @default(true)
  roleId               String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdCashMovements CashMovement[]
  closedCashSessions   CashSession[]       @relation("CashSessionClosedBy")
  openedCashSessions   CashSession[]       @relation("CashSessionOpenedBy")
  createdExpenses      Expense[]
  inventoryMovements   InventoryMovement[]
  createdOrders        Order[]
  createdPayments      Payment[]
  createdPurchases     Purchase[]
  role                 Role                @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Category {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  description  String?
  imageUrl     String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  products     Product[]

  @@index([isActive, displayOrder], map: "categories_active_idx")
  @@map("categories")
}

model Product {
  id           String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  categoryId   String?
  name         String
  description  String?
  sku          String?        @unique(map: "products_sku_unique", where: raw("(sku IS NOT NULL)"))
  imageUrl     String?
  price        Decimal        @default(0) @db.Decimal(12, 2)
  cost         Decimal        @default(0) @db.Decimal(12, 2)
  isActive     Boolean        @default(true)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  comboItems   ComboItem[]
  orderItems   OrderItem[]
  extras       ProductExtra[]
  category     Category?      @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  recipes      Recipe[]

  @@index([isActive, displayOrder], map: "products_active_idx")
  @@index([categoryId], map: "products_category_idx")
  @@map("products")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Extra {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  name            String
  description     String?
  price           Decimal          @default(0) @db.Decimal(12, 2)
  cost            Decimal          @default(0) @db.Decimal(12, 2)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  recipes         ExtraRecipe[]
  orderItemExtras OrderItemExtra[]
  products        ProductExtra[]

  @@map("extras")
}

model ProductExtra {
  productId String
  extraId   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  extra     Extra    @relation(fields: [extraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([productId, extraId])
  @@map("productExtras")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Combo {
  id          String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  description String?
  price       Decimal     @default(0) @db.Decimal(12, 2)
  cost        Decimal     @default(0) @db.Decimal(12, 2)
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  items       ComboItem[]
  orderItems  OrderItem[]

  @@map("combos")
}

model ComboItem {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  comboId   String
  productId String
  quantity  Decimal  @default(1) @db.Decimal(12, 3)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  combo     Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onUpdate: NoAction)

  @@unique([comboId, productId], map: "comboItems_unique")
  @@index([comboId], map: "comboItems_combo_idx")
  @@map("comboItems")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model InventoryUnit {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  abbreviation String
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  ingredients  Ingredient[]

  @@map("inventoryUnits")
}

model Ingredient {
  id            String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  sku           String?             @unique(map: "ingredients_sku_unique", where: raw("(sku IS NOT NULL)"))
  unitId        String
  currentStock  Decimal             @default(0) @db.Decimal(14, 4)
  minimumStock  Decimal             @default(0) @db.Decimal(14, 4)
  averageCost   Decimal             @default(0) @db.Decimal(14, 4)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  extraRecipes  ExtraRecipe[]
  unit          InventoryUnit       @relation(fields: [unitId], references: [id], onUpdate: NoAction)
  movements     InventoryMovement[]
  purchaseItems PurchaseItem[]
  recipes       Recipe[]

  @@index([isActive], map: "ingredients_active_idx")
  @@index([currentStock, minimumStock], map: "inventory_low_stock_idx", where: raw("(\"isActive\" = true)"))
  @@map("ingredients")
}

model Recipe {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  productId    String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 4)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onUpdate: NoAction)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, ingredientId], map: "recipes_unique")
  @@index([productId], map: "recipes_product_idx")
  @@map("recipes")
}

model ExtraRecipe {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  extraId      String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 4)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  extra        Extra      @relation(fields: [extraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onUpdate: NoAction)

  @@unique([extraId, ingredientId], map: "extraRecipes_unique")
  @@map("extraRecipes")
}

model InventoryMovement {
  id            String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  ingredientId  String
  type          String
  quantity      Decimal    @db.Decimal(14, 4)
  unitCost      Decimal    @default(0) @db.Decimal(14, 4)
  referenceType String?
  referenceId   String?
  notes         String?
  createdById   String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  createdBy     User?      @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onUpdate: NoAction)

  @@index([ingredientId, createdAt(sort: Desc)], map: "inventoryMovements_ingredient_idx")
  @@index([referenceType, referenceId], map: "inventoryMovements_reference_idx")
  @@map("inventoryMovements")
}

model Supplier {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  purchases Purchase[]

  @@index([isActive], map: "suppliers_active_idx")
  @@map("suppliers")
}

model Purchase {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  supplierId    String?
  invoiceNumber String?
  status        String         @default("draft")
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @default(0) @db.Decimal(12, 2)
  notes         String?
  purchasedAt   DateTime       @default(now()) @db.Timestamptz(6)
  createdById   String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  items         PurchaseItem[]
  createdBy     User?          @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onUpdate: NoAction)

  @@index([purchasedAt], map: "purchases_date_idx")
  @@index([supplierId], map: "purchases_supplier_idx")
  @@map("purchases")
}

model PurchaseItem {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  purchaseId   String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 4)
  unitCost     Decimal    @db.Decimal(14, 4)
  total        Decimal?   @default(dbgenerated("round((quantity * \"unitCost\"), 2)")) @db.Decimal(14, 2)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onUpdate: NoAction)
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([purchaseId], map: "purchaseItems_purchase_idx")
  @@map("purchaseItems")
}

model CashRegister {
  id          String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  sessions    CashSession?

  @@map("cashRegisters")
}

model CashSession {
  id             String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  cashRegisterId String         @unique(map: "cashSessions_one_open_per_register", where: raw("(status = 'open'::text)"))
  openedById     String
  closedById     String?
  openingAmount  Decimal        @default(0) @db.Decimal(12, 2)
  expectedAmount Decimal        @default(0) @db.Decimal(12, 2)
  closingAmount  Decimal?       @db.Decimal(12, 2)
  difference     Decimal?       @db.Decimal(12, 2)
  status         String         @default("open")
  openedAt       DateTime       @default(now()) @db.Timestamptz(6)
  closedAt       DateTime?      @db.Timestamptz(6)
  movements      CashMovement[]
  cashRegister   CashRegister   @relation(fields: [cashRegisterId], references: [id], onUpdate: NoAction)
  closedBy       User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id], onUpdate: NoAction)
  openedBy       User           @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onUpdate: NoAction)
  expenses       Expense[]
  orders         Order[]

  @@index([openedAt(sort: Desc)])
  @@map("cashSessions")
}

model CashMovement {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  cashSessionId String
  type          String
  amount        Decimal     @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  description   String?
  createdById   String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onUpdate: NoAction)
  createdBy     User?       @relation(fields: [createdById], references: [id], onUpdate: NoAction)

  @@index([referenceType, referenceId], map: "cashMovements_reference_idx")
  @@index([cashSessionId, createdAt], map: "cashMovements_session_idx")
  @@map("cashMovements")
}

model Expense {
  id            String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  cashSessionId String?
  category      String
  description   String
  amount        Decimal      @db.Decimal(12, 2)
  expenseDate   DateTime     @default(now()) @db.Timestamptz(6)
  createdById   String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onUpdate: NoAction)
  createdBy     User?        @relation(fields: [createdById], references: [id], onUpdate: NoAction)

  @@index([category])
  @@index([expenseDate(sort: Desc)], map: "expenses_date_idx")
  @@map("expenses")
}

model Order {
  id                 String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderNumber        BigInt       @unique @default(autoincrement())
  cashSessionId      String?
  status             OrderStatus  @default(pending)
  customerName       String?
  subtotal           Decimal      @default(0) @db.Decimal(12, 2)
  discount           Decimal      @default(0) @db.Decimal(12, 2)
  tax                Decimal      @default(0) @db.Decimal(12, 2)
  total              Decimal      @default(0) @db.Decimal(12, 2)
  totalCost          Decimal?     @db.Decimal(12, 2)
  notes              String?
  inventoryProcessed Boolean      @default(false)
  createdById        String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  completedAt        DateTime?    @db.Timestamptz(6)
  items              OrderItem[]
  cashSession        CashSession? @relation(fields: [cashSessionId], references: [id], onUpdate: NoAction)
  createdBy          User?        @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  payments           Payment[]
  ticket             Ticket?

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([cashSessionId], map: "orders_cashSession_idx")
  @@index([createdAt], map: "orders_completed_date_idx", where: raw("(status = 'completed'::text)"))
  @@map("orders")
}

model OrderItem {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId     String
  productId   String?
  comboId     String?
  productName String
  quantity    Decimal          @db.Decimal(12, 3)
  unitPrice   Decimal          @db.Decimal(12, 2)
  discount    Decimal          @default(0) @db.Decimal(12, 2)
  subtotal    Decimal          @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  costSnapshot Decimal?         @db.Decimal(12, 2)
  extras      OrderItemExtra[]
  combo       Combo?           @relation(fields: [comboId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     Product?         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([comboId], map: "orderItems_combo_idx")
  @@index([orderId], map: "orderItems_order_idx")
  @@index([productId], map: "orderItems_product_idx")
  @@map("orderItems")
}

model OrderItemExtra {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderItemId String
  extraId     String?
  extraName   String
  quantity    Decimal   @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal   @db.Decimal(12, 2)
  subtotal    Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  costSnapshot Decimal?  @db.Decimal(12, 2)
  extra       Extra?    @relation(fields: [extraId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderItemId], map: "orderItemExtras_orderItem_idx")
  @@map("orderItemExtras")
}

model Payment {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId     String
  method      String
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("paid")
  reference   String?
  paidAt      DateTime @default(now()) @db.Timestamptz(6)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdBy   User?    @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([method])
  @@index([paidAt(sort: Desc)])
  @@index([orderId], map: "payments_order_idx")
  @@index([paidAt], map: "payments_paid_date_idx", where: raw("(status = 'paid'::text)"))
  @@map("payments")
}

model Ticket {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId      String    @unique
  ticketNumber BigInt    @unique @default(autoincrement())
  printedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("tickets")
}

enum OrderStatus {
  pending
  completed
  cancelled
}
