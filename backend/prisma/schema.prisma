generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model User {
  id                   String                  @id @default(uuid())
  name                 String
  email                String                  @unique
  passwordHash         String
  isActive             Boolean                 @default(true)
  roleId               String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  createdCashMovements CashMovement[]
  closedCashSessions   CashSession[]           @relation("CashSessionClosedBy")
  openedCashSessions   CashSession[]           @relation("CashSessionOpenedBy")
  createdExpenses      Expense[]
  inventoryMovements   InventoryMovement[]
  createdOrders        Order[]
  createdPayments      Payment[]
  createdPurchases     Purchase[]
  role                 Role                    @relation(fields: [roleId], references: [id])
  notifications        NotificationRecipient[]
  auditLogs            AuditLog[]
  inventoryCountsCreated InventoryCount[]      @relation("InventoryCountCreatedBy")
  inventoryCountsCompleted InventoryCount[]    @relation("InventoryCountCompletedBy")

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Category {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                String                @unique
  description         String?
  imageUrl            String?
  displayOrder        Int                   @default(0)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  products            Product[]
  combos              Combo[]
  PromotionOnCategory PromotionOnCategory[]

  @@index([isActive, displayOrder], map: "categories_active_idx")
  @@map("categories")
}

model Product {
  id                 String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  categoryId         String?
  name               String
  description        String?
  sku                String               @unique
  imageUrl           String?
  price              Decimal              @default(0) @db.Decimal(12, 2)
  cost               Decimal              @default(0) @db.Decimal(12, 2)
  isActive           Boolean              @default(true)
  displayOrder       Int                  @default(0)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  comboItems         ComboItem[]
  orderItems         OrderItem[]
  extras             ProductExtra[]
  category           Category?            @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  recipes            Recipe[]
  PromotionOnProduct PromotionOnProduct[]

  @@index([isActive, displayOrder], map: "products_active_idx")
  @@index([categoryId], map: "products_category_idx")
  @@map("products")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Extra {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  name            String
  description     String?
  price           Decimal          @default(0) @db.Decimal(12, 2)
  cost            Decimal          @default(0) @db.Decimal(12, 2)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  recipes         ExtraRecipe[]
  orderItemExtras OrderItemExtra[]
  products        ProductExtra[]

  @@map("extras")
}

model ProductExtra {
  productId String
  extraId   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  extra     Extra    @relation(fields: [extraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([productId, extraId])
  @@map("product_extras")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Combo {
  id           String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  categoryId   String?
  name         String      @unique
  description  String?
  price        Decimal     @default(0) @db.Decimal(12, 2)
  cost         Decimal     @default(0) @db.Decimal(12, 2)
  imageUrl     String?
  isActive     Boolean     @default(true)
  activeOnDays Int[]
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  items        ComboItem[]
  soldAsItems  OrderItem[]
  category     Category?   @relation(fields: [categoryId], references: [id], onUpdate: NoAction)

  @@index([isActive, displayOrder], map: "combos_active_idx")
  @@index([categoryId], map: "combos_category_idx")
  @@map("combos")
}

model ComboItem {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  comboId   String
  productId String
  quantity  Decimal  @default(1) @db.Decimal(12, 3)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  combo     Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onUpdate: NoAction)

  @@unique([comboId, productId], map: "comboItems_unique")
  @@index([comboId], map: "comboItems_combo_idx")
  @@map("combo_items")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model InventoryUnit {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  abbreviation String
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  ingredients  Ingredient[]

  @@map("inventory_units")
}

model Ingredient {
  id            String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  // Physically a partial index (WHERE sku IS NOT NULL) from an earlier raw-SQL migration;
  // functionally equivalent to a plain @unique on a nullable column (Postgres unique
  // indexes already allow multiple NULLs), so `prisma migrate diff` reports a harmless
  // false-positive here. See 20260916000000_sync_schema_drift/migration.sql.
  sku           String?              @unique(map: "ingredients_sku_unique")
  unitId        String
  currentStock  Decimal             @default(0) @db.Decimal(14, 4)
  minimumStock  Decimal             @default(0) @db.Decimal(14, 4)
  averageCost   Decimal             @default(0) @db.Decimal(14, 4)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  extraRecipes  ExtraRecipe[]
  unit          InventoryUnit       @relation(fields: [unitId], references: [id], onUpdate: NoAction)
  movements     InventoryMovement[]
  purchaseItems PurchaseItem[]
  recipes       Recipe[]
  countItems    InventoryCountItem[]

  @@index([isActive], map: "ingredients_active_idx")
  // @@index([currentStock, minimumStock], map: "inventory_low_stock_idx", where: raw("(\"isActive\" = true)"))
  // The following exist in the database via raw-SQL migration
  // 20260914000000_add_duplicate_prevention_indexes but can't be declared here: Prisma's
  // schema syntax doesn't support expression/partial indexes on LOWER(TRIM(name)). Do not
  // "fix" the drift reported by `prisma migrate diff` for these — recreating them without
  // the expression/WHERE clause would create a different, non-equivalent index.
  //   ingredients_name_normalized_unique: UNIQUE (LOWER(TRIM(name))) WHERE "isActive" = true
  //   ingredients_name_search_idx: INDEX (LOWER(TRIM(name))) WHERE "isActive" = true
  @@map("ingredients")
}

model Recipe {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  productId    String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 4)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onUpdate: NoAction)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, ingredientId], map: "recipes_unique")
  @@index([productId], map: "recipes_product_idx")
  @@map("recipes")
}

model ExtraRecipe {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  extraId      String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 4)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  extra        Extra      @relation(fields: [extraId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onUpdate: NoAction)

  @@unique([extraId, ingredientId], map: "extraRecipes_unique")
  @@map("extra_recipes")
}

model InventoryMovement {
  id            String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  ingredientId  String
  type          String
  quantity      Decimal    @db.Decimal(14, 4)
  unitCost      Decimal    @default(0) @db.Decimal(14, 4)
  referenceType String?
  referenceId   String?
  reason        String?
  notes         String?
  createdById   String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  createdBy     User?      @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onUpdate: NoAction)

  @@index([ingredientId, createdAt(sort: Desc)], map: "inventoryMovements_ingredient_idx")
  @@index([referenceType, referenceId], map: "inventoryMovements_reference_idx")
  @@index([createdAt(sort: Desc)], map: "inventoryMovements_createdAt_idx")
  @@map("inventory_movements")
}

model Supplier {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  purchases Purchase[]

  @@index([isActive], map: "suppliers_active_idx")
  // Same as Ingredient above: these exist via raw-SQL migration
  // 20260914000000_add_duplicate_prevention_indexes and can't be declared here.
  //   suppliers_name_normalized_unique: UNIQUE (LOWER(TRIM(name))) WHERE "isActive" = true
  //   suppliers_name_search_idx: INDEX (LOWER(TRIM(name))) WHERE "isActive" = true
  @@map("suppliers")
}

model PurchaseInvoiceCounter {
  date  String  @id
  count Int     @default(0)

  @@map("purchase_invoice_counters")
}

model Purchase {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  supplierId    String?
  invoiceNumber String?
  status        String         @default("draft")
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @default(0) @db.Decimal(12, 2)
  notes         String?
  purchasedAt   DateTime       @default(now()) @db.Timestamptz(6)
  createdById   String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  items         PurchaseItem[]
  createdBy     User?          @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onUpdate: NoAction)

  @@index([purchasedAt], map: "purchases_date_idx")
  @@index([supplierId], map: "purchases_supplier_idx")
  @@map("purchases")
}

model PurchaseItem {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  purchaseId   String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 4)
  unitCost     Decimal    @db.Decimal(14, 4)
  total        Decimal?   @db.Decimal(14, 2)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onUpdate: NoAction)
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([purchaseId], map: "purchaseItems_purchase_idx")
  @@map("purchase_items")
}

model CashRegister {
  id          String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  sessions    CashSession[]

  @@map("cash_registers")
}

model CashSession {
  id             String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  cashRegisterId String
  openedById     String
  closedById     String?
  openingAmount  Decimal        @default(0) @db.Decimal(12, 2)
  expectedAmount Decimal        @default(0) @db.Decimal(12, 2)
  closingAmount  Decimal?       @db.Decimal(12, 2)
  difference     Decimal?       @db.Decimal(12, 2)
  status         String         @default("open")
  openedAt       DateTime       @default(now()) @db.Timestamptz(6)
  closedAt       DateTime?      @db.Timestamptz(6)
  closingReason  String?
  closingComment String?
  movements      CashMovement[]
  cashRegister   CashRegister   @relation(fields: [cashRegisterId], references: [id], onUpdate: NoAction)
  closedBy       User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id], onUpdate: NoAction)
  openedBy       User           @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onUpdate: NoAction)
  expenses       Expense[]
  orders         Order[]
  auditLogs      AuditLog[]

  @@index([openedAt(sort: Desc)])
  @@index([cashRegisterId, openedAt(sort: Desc)], map: "cashSessions_register_history_idx")
  @@map("cash_sessions")
}

model CashMovement {
  id             String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  cashSessionId  String
  type           String
  amount         Decimal     @db.Decimal(12, 2)
  receivedAmount Decimal?    @db.Decimal(12, 2)
  changeAmount   Decimal?    @db.Decimal(12, 2)
  referenceType  String?
  referenceId    String?
  description    String?
  createdById    String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  cashSession    CashSession @relation(fields: [cashSessionId], references: [id], onUpdate: NoAction)
  createdBy      User?       @relation(fields: [createdById], references: [id], onUpdate: NoAction)

  @@index([referenceType, referenceId], map: "cashMovements_reference_idx")
  @@index([cashSessionId, createdAt], map: "cashMovements_session_idx")
  @@map("cash_movements")
}

model Expense {
  id            String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  cashSessionId String?
  category      String
  description   String
  amount        Decimal      @db.Decimal(12, 2)
  paymentMethod String       @default("cash")
  expenseDate   DateTime     @default(now()) @db.Timestamptz(6)
  // Set only for expenses auto-generated by a sale (e.g. a 'mandadito' the business absorbs).
  // Lets order cancellation find and remove the derived expense instead of leaving it orphaned.
  sourceOrderId String?
  createdById   String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onUpdate: NoAction)
  createdBy     User?        @relation(fields: [createdById], references: [id], onUpdate: NoAction)

  @@index([category])
  @@index([expenseDate(sort: Desc)], map: "expenses_date_idx")
  @@index([cashSessionId])
  @@index([sourceOrderId])
  @@map("expenses")
}

model AuditLog {
  id            String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId        String
  action        String
  cashSessionId String?
  metadata      Json?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  @@index([cashSessionId, createdAt], map: "auditLogs_cashSession_idx")
  @@index([userId, createdAt], map: "auditLogs_user_idx")
  @@map("audit_logs")
}

model Order {
  id                 String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderNumber        BigInt       @unique @default(autoincrement())
  cashSessionId      String?
  status             OrderStatus  @default(pending)
  customerName       String?
  subtotal           Decimal      @default(0) @db.Decimal(12, 2)
  discount           Decimal      @default(0) @db.Decimal(12, 2)
  tax                Decimal      @default(0) @db.Decimal(12, 2)
  total              Decimal      @default(0) @db.Decimal(12, 2)
  totalCost          Decimal?     @db.Decimal(12, 2)
  idempotencyKey     String?
  notes              String?
  inventoryProcessed Boolean      @default(false)
  hasDelivery           Boolean   @default(false)
  deliveryAmount        Decimal   @default(0) @db.Decimal(12, 2)
  deliveryResponsible   String? // 'customer_to_courier' | 'customer_to_business' | 'business_absorbs'
  deliveryPaymentMethod String? // 'cash' | 'transfer' — only when deliveryResponsible = 'customer_to_business'
  deliveryHandedOff     Boolean   @default(false)
  deliveryHandedOffAt   DateTime? @db.Timestamptz(6)
  createdById        String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  completedAt        DateTime?    @db.Timestamptz(6)
  items              OrderItem[]
  cashSession        CashSession? @relation(fields: [cashSessionId], references: [id], onUpdate: NoAction)
  createdBy          User?        @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  payments           Payment[]
  ticket             Ticket?

  @@unique([createdById, idempotencyKey], map: "orders_createdBy_idempotencyKey_unique")
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([cashSessionId], map: "orders_cashSession_idx")
  // @@index([createdAt], map: "orders_completed_date_idx", where: raw("(status = 'completed'::\"OrderStatus\")"))
  @@map("orders")
}

model OrderItem {
  id            String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId       String
  productId     String
  productName   String
  quantity      Decimal          @db.Decimal(12, 3)
  unitPrice     Decimal          @db.Decimal(12, 2)
  discount      Decimal          @default(0) @db.Decimal(12, 2)
  subtotal      Decimal          @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  costSnapshot  Decimal?         @db.Decimal(12, 2)
  extras        OrderItemExtra[]
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceComboId String?
  sourceCombo   Combo?           @relation(fields: [sourceComboId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "orderItems_order_idx")
  @@index([productId], map: "orderItems_product_idx")
  @@index([sourceComboId])
  @@map("order_items")
}

model OrderItemExtra {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderItemId  String
  extraId      String?
  extraName    String
  quantity     Decimal   @default(1) @db.Decimal(12, 3)
  unitPrice    Decimal   @db.Decimal(12, 2)
  subtotal     Decimal   @db.Decimal(12, 2)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  costSnapshot Decimal?  @db.Decimal(12, 2)
  extra        Extra?    @relation(fields: [extraId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderItemId], map: "orderItemExtras_orderItem_idx")
  @@map("order_item_extras")
}

model Payment {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId     String
  method      String
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("paid")
  reference   String?
  paidAt      DateTime @default(now()) @db.Timestamptz(6)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdBy   User?    @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([method])
  @@index([paidAt(sort: Desc)])
  @@index([orderId], map: "payments_order_idx")
  // @@index([paidAt], map: "payments_paid_date_idx", where: raw("(status = 'paid'::text)"))
  @@map("payments")
}

model Ticket {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId      String    @unique
  ticketNumber BigInt    @unique @default(autoincrement())
  printedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("tickets")
}

enum OrderStatus {
  pending
  preparing
  ready
  completed
  cancelled
}

enum PromotionType {
  PERCENTAGE
  FIXED_DISCOUNT
  FIXED_PRICE
  BOGO
  MULTIBUY_FIXED_PRICE
}

model Promotion {
  id            String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  description   String?
  type          PromotionType         @default(PERCENTAGE)
  discountValue Decimal               @db.Decimal(10, 2)
  buyQuantity   Int?
  getQuantity   Int?
  startDate     DateTime
  endDate       DateTime
  activeOnDays  Int[]
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  products      PromotionOnProduct[]
  categories    PromotionOnCategory[]

  @@map("promotions")
}

model PromotionOnProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@id([promotionId, productId])
}

model PromotionOnCategory {
  promotionId String
  categoryId  String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])

  @@id([promotionId, categoryId])
}

enum NotificationType {
  GENERAL
  NEW_ORDER
  LOW_STOCK
}

model Notification {
  id          String                  @id @default(uuid())
  title       String
  message     String
  type        NotificationType        @default(GENERAL)
  referenceId String? // e.g., orderId, inventoryId
  createdAt   DateTime                @default(now())
  recipients  NotificationRecipient[]

  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationRecipient {
  notificationId String
  userId         String
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_recipients")
}

model InventoryCount {
  id            String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  status        String                  @default("draft")
  notes         String?
  countedAt     DateTime                @default(now()) @db.Timestamptz(6)
  createdById   String?
  completedById String?
  completedAt   DateTime?               @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  items         InventoryCountItem[]
  createdBy     User?                   @relation("InventoryCountCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  completedBy   User?                   @relation("InventoryCountCompletedBy", fields: [completedById], references: [id], onUpdate: NoAction)

  @@index([status])
  @@index([countedAt(sort: Desc)])
  @@index([createdById])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id               String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  inventoryCountId String
  ingredientId     String
  systemQuantity   Decimal        @db.Decimal(14, 4)
  countedQuantity  Decimal        @db.Decimal(14, 4)
  difference       Decimal        @db.Decimal(14, 4)
  notes            String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingredient       Ingredient     @relation(fields: [ingredientId], references: [id], onUpdate: NoAction)

  @@unique([inventoryCountId, ingredientId], map: "inventoryCountItems_unique")
  @@index([inventoryCountId])
  @@map("inventory_count_items")
}

model SystemPreference {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, number, boolean, json
  label     String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_preferences")
}

model IncomeStatementDailySnapshot {
  id                      String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  date                    DateTime @unique @db.Date
  hadOperation            Boolean  @default(false)
  openingFund             Decimal  @default(0) @db.Decimal(12, 2)
  cashRevenue             Decimal  @default(0) @db.Decimal(12, 2)
  transferRevenue         Decimal  @default(0) @db.Decimal(12, 2)
  otherRevenue            Decimal  @default(0) @db.Decimal(12, 2)
  totalRevenue            Decimal  @default(0) @db.Decimal(12, 2)
  totalCogs               Decimal  @default(0) @db.Decimal(12, 2)
  grossProfit             Decimal  @default(0) @db.Decimal(12, 2)
  totalExpenses           Decimal  @default(0) @db.Decimal(12, 2)
  netProfit               Decimal  @default(0) @db.Decimal(12, 2)
  expectedCash            Decimal? @db.Decimal(12, 2)
  actualCash              Decimal? @db.Decimal(12, 2)
  cashDifference          Decimal? @db.Decimal(12, 2)
  cashStatus              String? // 'CUADRADA' | 'SOBRANTE' | 'FALTANTE' | 'PENDIENTE' | null
  savingsAmount           Decimal  @default(0) @db.Decimal(12, 2)
  businessFundAmount      Decimal  @default(0) @db.Decimal(12, 2)
  suppliesAmount          Decimal  @default(0) @db.Decimal(12, 2)
  savingsAccumulated      Decimal  @default(0) @db.Decimal(12, 2)
  businessFundAccumulated Decimal  @default(0) @db.Decimal(12, 2)
  suppliesAccumulated     Decimal  @default(0) @db.Decimal(12, 2)
  savingsPercentUsed      Decimal  @db.Decimal(5, 2)
  businessFundPercentUsed Decimal  @db.Decimal(5, 2)
  suppliesPercentUsed     Decimal  @db.Decimal(5, 2)
  fixedExpensesAmount     Decimal  @default(0) @db.Decimal(12, 2)
  fixedExpenseRateUsed    Decimal  @default(0) @db.Decimal(12, 2)
  sessionsCount           Int      @default(0)
  openSessionsCount       Int      @default(0)
  isFinal                 Boolean  @default(false)
  computedAt              DateTime @updatedAt
  createdAt               DateTime @default(now())

  @@index([isFinal, date])
  @@map("income_statement_daily_snapshots")
}
